<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nada do app vai para o backup na nuvem NEM é copiado na transferência direta
  de um celular para outro (allowBackup=false não cobre a transferência). Assim a sessão de
  login, as preferências e o log interno nunca saem do aparelho; no celular novo a pessoa
  entra de novo com a conta.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
