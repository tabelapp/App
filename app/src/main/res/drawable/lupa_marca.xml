<?xml version="1.0" encoding="utf-8"?>
<!--
  Lupa da marca (identidade de 16/10/2026): disco amarelo, aro e cabo pretos, cifrão vermelho
  escuro. Vetor (nítido em qualquer tela). Mesma geometria do ícone do app: cabe no círculo
  central de 72 dp, como pede o splash do Android 12+.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="1.05"
        android:scaleY="1.05"
        android:translateX="2"
        android:translateY="4">
        <!-- cabo inclinado -->
        <path
            android:strokeColor="@color/contorno_lupa"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:pathData="M61,59 L72,70" />
        <!-- disco amarelo dentro do aro -->
        <path
            android:fillColor="@color/amarelo_marca"
            android:pathData="M31,46 A17,17 0 1,1 65,46 A17,17 0 1,1 31,46 Z" />
        <!-- aro -->
        <path
            android:strokeColor="@color/contorno_lupa"
            android:strokeWidth="6"
            android:pathData="M31,46 A17,17 0 1,1 65,46 A17,17 0 1,1 31,46 Z" />
        <!-- cifrão -->
        <path
            android:strokeColor="@color/vermelho_marca"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M48,34.5 L48,57.5" />
        <path
            android:strokeColor="@color/vermelho_marca"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:pathData="M52.8,37.8 A5.5,5.5 0 1,0 48,46 A5.5,5.5 0 1,1 43.2,54.2" />
    </group>
</vector>
